# RidePod payment provider.
# MOCK is the default and keeps all money movement local/mock.
# STRIPE_TEST is for future Stripe test-mode slices only.
PAYMENT_PROVIDER=MOCK

# Stripe test-mode keys only. Do not use sk_live_ or pk_live_ keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Reserved for a future webhook slice.
STRIPE_WEBHOOK_SECRET=

# Supabase MVP data layer. Public values are safe for browser clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RIDEPOD_USE_SUPABASE_STORAGE=false

# Optional Mapbox public browser token for legacy pod-detail route previews.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public browser key for Google Maps JavaScript, Places, Geocoding, and Routes.
# Restrict this key by HTTP referrer in Google Cloud; it is not a server secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only. Never expose this value to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=
